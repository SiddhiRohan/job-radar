# Your settings. start.py copies this file to .env the first time; .env never enters git.

# Needed for scoring and tailoring. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: statuses from hiring emails. A Gmail app password, not your normal password (docs/CONFIG.md, Email).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: the name used to sign cover letters, and the first name the assistant uses.
OWNER_NAME=
OWNER_SHORT=

# Optional: a different Claude model for scoring and tailoring.
# ANTHROPIC_MODEL=

# Only for the original Resume/ folder tree (docs/CONFIG.md, Your resume and profile).
# RESUME_FILENAME=
# SKILLS_STOPWORDS=
